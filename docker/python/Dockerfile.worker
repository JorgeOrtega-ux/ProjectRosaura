FROM python:3.11-slim

RUN apt-get update && apt-get install -y default-mysql-client tzdata && rm -rf /var/lib/apt/lists/*

WORKDIR /app


RUN pip install --no-cache-dir cryptography mysql-connector-python pymysql redis python-dotenv requests websockets Pillow numpy typesense


CMD ["python", "-u", "scripts/worker_backups.py"]