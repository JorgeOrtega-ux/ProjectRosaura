# ==========================================
# APLICACIÓN
# ==========================================
APP_NAME=ProjectRosaura
APP_URL=http://localhost
APP_VERSION=2.0.0
APP_TIMEZONE=UTC

# ==========================================
# BASE DE DATOS
# ==========================================
DB_ROOT_PASSWORD=
DB_USER=
DB_PASS=
DB_PORT=3306
DB_HOST=
DB_IDENTITY_NAME=db_identity
DB_CANVASES_NAME=db_canvases
DB_SUPPORT_NAME=db_support

# ==========================================
# CACHÉ Y SESIONES (REDIS)
# ==========================================
REDIS_HOST=
REDIS_PORT=
REDIS_PASS=

# ==========================================
# CLOUDFLARE TURNSTILE
# ==========================================
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ==========================================
# EMAIL (SMTP)
# ==========================================
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=

# ==========================================
# BACKUPS (WORKER)
# ==========================================
BACKUP_ENCRYPTION_KEY=

# ==========================================
# TELEMETRÍA Y ANALÍTICAS
# ==========================================
DB_TELEMETRY_HOST=
DB_TELEMETRY_NAME=
DB_TELEMETRY_USER=
DB_TELEMETRY_PASSWORD=

# ==========================================
# WEBSOCKETS (TIEMPO REAL)
# ==========================================
WS_HOST=0.0.0.0
WS_PORT=8765
WS_MAX_CONNECTIONS=1000
WS_QOS_THRESHOLD=100

# ==========================================
# WORKERS Y TAREAS PROGRAMADAS
# ==========================================
WORKER_CANVAS_SYNC_INTERVAL=10
WORKER_CANVAS_BATCH_SIZE=50
WORKER_CHAT_SYNC_INTERVAL=10
WORKER_CHAT_BATCH_SIZE=50

# ==========================================
# SNAPSHOTS Y MEDIA
# ==========================================
SNAPSHOT_SCALE_FACTOR=1.0

# ==========================================
# MOTOR DE BÚSQUEDA (TYPESENSE)
# ==========================================
TYPESENSE_HOST=typesense
TYPESENSE_PORT=8108
TYPESENSE_PROTOCOL=http
TYPESENSE_API_KEY=

# ==========================================
# GOOGLE OAUTH
# ==========================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ==========================================


# ==========================================
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_COINS_1000=
STRIPE_PRICE_COINS_2750=
STRIPE_PRICE_COINS_5750=
STRIPE_PRICE_COINS_13250=

# ==========================================
# AMAZON S3 / MINIO (ALMACENAMIENTO DE OBJETOS)
# ==========================================
AWS_ENDPOINT=http://minio:9000
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BUCKET=rosaura-storage
AWS_PUBLIC_URL=http://localhost:9000

# ==========================================
# SEGURIDAD API INTERNA (Rust <-> PHP)
# ==========================================
INTERNAL_API_SECRET=

# ==========================================
# CASSANDRA (NO SQL CHAT)
# ==========================================
CASSANDRA_HOST=cassandra
CASSANDRA_PORT=9042
CASSANDRA_KEYSPACE=db_canvases_nosql

# ==========================================
# CORREOS LEGALES Y POLÍTICAS
# ==========================================
CONTACT_EMAIL_PRIVACY=privacy@projectrosaura.com
CONTACT_EMAIL_LEGAL=legal@projectrosaura.com
CONTACT_EMAIL_BILLING=billing@projectrosaura.com

# ==========================================
# IA CONFIGURATION (OLLAMA / SUPPORT AGENTS)
# ==========================================
AI_PROVIDER=ollama
AI_OLLAMA_HOST=http://rosaura_ollama:11434
# Modelo recomendado para desarrollo local (CPU): qwen2.5:1.5b (1-2s latencia)
# Modelo para entornos de producción (GPU): qwen3:1.7b
AI_OLLAMA_MODEL=qwen2.5:1.5b
AI_TIMEOUT_SECONDS=15
AI_ENABLED=true

