# syntax=docker/dockerfile:1
FROM rust:alpine AS builder

WORKDIR /usr/src/app

# Dependencias del sistema para compilar con musl
RUN apk add --no-cache musl-dev gcc make openssl-dev

WORKDIR /usr/src/app/scripts/ws_server

# Copiar manifiestos primero para cachear dependencias
COPY scripts/ws_server/Cargo.toml ./
# Si existe Cargo.lock, copiarlo también
COPY scripts/ws_server/Cargo.lock* ./

# Pre-compilar dependencias con un main dummy
# BuildKit cachea ~/.cargo/registry y target/ entre builds
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/usr/src/app/scripts/ws_server/target \
    mkdir -p src && echo "fn main() {}" > src/main.rs && \
    cargo build --release && \
    rm src/main.rs

# Copiar el código real
COPY scripts/ws_server/src src/

# Compilar el binario real (solo recompila lo que cambió)
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/usr/src/app/scripts/ws_server/target \
    touch src/main.rs && \
    cargo build --release && \
    cp target/release/ws_server /tmp/ws_server

# Imagen final ultra ligera
FROM alpine:3.19
WORKDIR /app

RUN apk add --no-cache ca-certificates tzdata

COPY --from=builder /tmp/ws_server /usr/local/bin/ws_server

CMD ["ws_server"]
