# ==========================================
# APLICACIÓN
# ==========================================
COMPOSE_PROJECT_NAME=spriteboard
APP_NAME=Spriteboard
APP_URL=http://localhost
APP_VERSION=2.0.0
APP_TIMEZONE=UTC

# ==========================================
# BASE DE DATOS (ADMINISTRACIÓN Y CONEXIÓN BASE)
# ==========================================
DB_ROOT_PASSWORD=
DB_USER=system_web_executor
DB_PASS=
DB_PORT=3306
DB_HOST=127.0.0.1
DB_IDENTITY_NAME=db_identity
DB_CANVASES_NAME=db_canvases
DB_ADVERTISEMENTS_NAME=db_advertisements

# ==========================================
# SEGMENTACIÓN DE BASE DE DATOS (MÍNIMO PRIVILEGIO)
# ==========================================
DB_IDENTITY_USER=executor_identity
DB_IDENTITY_PASS=secret_identity_pass

DB_CANVASES_USER=executor_canvases
DB_CANVASES_PASS=secret_canvases_pass

DB_ADVERTISEMENTS_USER=executor_ads
DB_ADVERTISEMENTS_PASS=secret_ads_pass

DB_TELEMETRY_USER=executor_telemetry
DB_TELEMETRY_PASSWORD=secret_telemetry_pass

# ==========================================
# CACHÉ Y SESIONES (REDIS)
# ==========================================
REDIS_HOST=
REDIS_PORT=
REDIS_PASS=

# ==========================================
# CLOUDFLARE TURNSTILE
# ==========================================
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ==========================================
# EMAIL (SMTP)
# ==========================================
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=

# ==========================================
# BACKUPS (WORKER)
# ==========================================
BACKUP_ENCRYPTION_KEY=

# ==========================================
# TELEMETRÍA Y ANALÍTICAS
# ==========================================
DB_TELEMETRY_HOST=
DB_TELEMETRY_NAME=
DB_TELEMETRY_USER=
DB_TELEMETRY_PASSWORD=

# ==========================================
# WEBSOCKETS (TIEMPO REAL)
# ==========================================
WS_HOST=0.0.0.0
WS_PORT=8765
WS_MAX_CONNECTIONS=1000
WS_QOS_THRESHOLD=100

# ==========================================
# WORKERS Y TAREAS PROGRAMADAS
# ==========================================
WORKER_CANVAS_SYNC_INTERVAL=10
WORKER_CANVAS_BATCH_SIZE=50
WORKER_CHAT_SYNC_INTERVAL=10
WORKER_CHAT_BATCH_SIZE=50

# ==========================================
# SNAPSHOTS Y MEDIA
# ==========================================
SNAPSHOT_SCALE_FACTOR=1.0

# ==========================================
# MOTOR DE BÚSQUEDA (TYPESENSE)
# ==========================================
TYPESENSE_HOST=typesense
TYPESENSE_PORT=8108
TYPESENSE_PROTOCOL=http
TYPESENSE_API_KEY=

# ==========================================
# GOOGLE OAUTH
# ==========================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ==========================================
# PAGOS Y SUSCRIPCIONES (STRIPE)
# ==========================================
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# IDs de Precios de Planes (Stripe Price IDs)
STRIPE_PRICE_PLUS_MONTHLY=
STRIPE_PRICE_PLUS_YEARLY=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PRICE_ULTRA_MONTHLY=
STRIPE_PRICE_ULTRA_YEARLY=


# ==========================================
# AMAZON S3 / MINIO (ALMACENAMIENTO DE OBJETOS)
# ==========================================
AWS_ENDPOINT=http://minio:9000
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BUCKET=spriteboard-storage
AWS_PUBLIC_URL=http://localhost:9000

# ==========================================
# SEGURIDAD API INTERNA Y CIFRADO PII (AES-256-GCM)
# ==========================================
INTERNAL_API_SECRET=
PII_ENCRYPTION_KEY=

# ==========================================
# TRAZABILIDAD Y AUDITORÍA DE LOGS (HMAC / SIEM)
# ==========================================
LOG_HMAC_KEY=
SIEM_HOST=
SIEM_PORT=514
SIEM_PROTOCOL=udp

# ==========================================
# ANTIVIRUS Y ESCANEO DE ARCHIVOS (CLAMAV)
# ==========================================
CLAMAV_HOST=
CLAMAV_PORT=3310

# ==========================================
# CASSANDRA (NO SQL CHAT)
# ==========================================
CASSANDRA_HOST=cassandra
CASSANDRA_PORT=9042
CASSANDRA_KEYSPACE=db_canvases_nosql

# ==========================================
# CORREOS LEGALES Y POLÍTICAS
# ==========================================
CONTACT_EMAIL_PRIVACY=privacy@spriteboard.com
CONTACT_EMAIL_LEGAL=legal@spriteboard.com
CONTACT_EMAIL_BILLING=billing@spriteboard.com

